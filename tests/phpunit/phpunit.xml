<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/amorce.php"
         convertDeprecationsToExceptions="true"
         colors="true">
  <testsuites>
    <testsuite name="SAND Classes">
      <file>./tests/UrlTest.php</file>
      <file>./tests/RoutageTest.php</file>
      <file>./tests/UrlRoutageTest.php</file>
      <file>./tests/UrlLiensTest.php</file>
      <file>./tests/DebugEtReponsesTest.php</file>
      <file>./tests/DependancesTest.php</file>
    </testsuite>
    <testsuite name="SAND Session">
      <file>./tests/SessionTest.php</file>
    </testsuite>
    <testsuite name="SAND Bdd">
      <file>./tests/BddTest.php</file>
    </testsuite>
    <testsuite name="SAND Rendu">
      <file>./tests/RenduTest.php</file>
      <file>./tests/VueTest.php</file>
      <file>./tests/TwigEchappementTest.php</file>
      <file>./tests/ActionInsertionTest.php</file>
    </testsuite>
    <testsuite name="SAND Divers">
      <file>./tests/ModeleTest.php</file>
      <file>./tests/BrowserTest.php</file>
      <file>./tests/AsynchonousTest.php</file>
      <file>./tests/DumperTest.php</file>
      <file>./tests/JournalTest.php</file>
      <file>./tests/CaracterTest.php</file>
      <file>./tests/ConversionErreursTest.php</file>
    </testsuite>
    <testsuite name="SAND Api">
      <file>./tests/ApiRoutageTest.php</file>
      <file>./tests/ApiErefererTest.php</file>
      <file>./tests/ApiDurcissementTest.php</file>
      <file>./tests/ApiHttpTest.php</file>
    </testsuite>
  </testsuites>

  <logging>
    <junit outputFile="../build/logs/phpunit.xml"/>
    <testdoxHtml outputFile="../build/logs/phpunit.html"/>
  </logging>
</phpunit>
